{"status":"OK","data":{"id":50136,"identifier":"8Y16HU","persistentUrl":"https://doi.org/10.23708/8Y16HU","protocol":"doi","authority":"10.23708","publisher":"DataSuds","publicationDate":"2026-09-09","storageIdentifier":"file://10.23708/8Y16HU","latestVersion":{"id":28049,"datasetId":50136,"datasetPersistentId":"doi:10.23708/8Y16HU","storageIdentifier":"file://10.23708/8Y16HU","versionNumber":1,"versionMinorNumber":0,"versionState":"RELEASED","latestVersionPublishingState":"RELEASED","distributionDate":"2026-09-10","productionDate":"2026-09-10","UNF":"UNF:6:D9m+vD54QSu8IwamgyGjfw==","lastUpdateTime":"2026-09-09T12:46:57Z","releaseTime":"2026-09-09T12:46:57Z","createTime":"2026-09-06T04:01:35Z","publicationDate":"2026-09-09","citationDate":"2026-09-09","license":{"name":"CC BY-NC 4.0","uri":"http://creativecommons.org/licenses/by-nc/4.0","iconUri":"https://licensebuttons.net/l/by-nc/4.0/88x31.png"},"contactForAccess":"sebastien.hardy@ird.fr","fileAccessRequest":true,"metadataBlocks":{"citation":{"displayName":"Citation Metadata","name":"citation","fields":[{"typeName":"title","multiple":false,"typeClass":"primitive","value":"Historical database of urban flooding in Ho Chi Minh City, Vietnam (2002–2026)"},{"typeName":"author","multiple":true,"typeClass":"compound","value":[{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Hardy, Sebastien"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"UMR IGE - CNRS, Grenoble INP, INRAE, IRD, Univ. Grenoble Alpes - France"},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"0000-0002-2815-8147"}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Radziute, Gintaré"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"UMR IGE - CNRS, Grenoble INP, INRAE, IRD, Univ. Grenoble Alpes - France"}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"HARDY, Sebastien"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"UMR IGE - CNRS, Grenoble INP, INRAE, IRD, Univ. Grenoble Alpes - France"},"datasetContactEmail":{"typeName":"datasetContactEmail","multiple":false,"typeClass":"primitive","value":"Sebastien.Hardy@ird.fr"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"This dataset compiles 425 geolocated observations of urban flooding\nin Ho Chi Minh City, recorded between 2002 and 2026 from 53 sources\n(mainly Vietnamese newspapers, along with a few technical reports).<br>\nEach observation documents the date, location (name, type,\nward/commune, and the current administrative unit following the 2025\nadministrative reform), water height (minimum/maximum in cm and depth\nclass), cause (rain, high tide, or combined), impact type, source,\nspatial precision, and geocoding method.\n<br><br>\n<u>The dataset also includes complementary layers:</u>\n<ul>\n<li>administrative boundaries before/after the 2025 reform\n<li>population density by district (2019)\n<li>flood recurrence by street\n<li>rivers, canals and water bodies\n<li>verified industrial zones\n</ul>\nThis work was carried out as part of a Master's (M2) internship (IGE,\nApril–August 2026) within LMI CARE, under the supervision of Sébastien\nHardy (IRD). The Master's thesis was defended on 10 September 2026.\n<br><br>\n<u><b>Summary of methodology:</u></b> multilingual documentary research (French,\nEnglish, Vietnamese, and to a lesser extent Russian) using targeted\nkeywords; manual extraction and geolocation of reported events;\nharmonization with administrative references before and after the\n2025 reform (see <A HREF='https://bando.tphcm.gov.vn/'>https://bando.tphcm.gov.vn/</A>); GIS processing under ArcGIS Pro."},"dsDescriptionDate":{"typeName":"dsDescriptionDate","multiple":false,"typeClass":"primitive","value":"2026-09-06"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Earth and Environmental Sciences","Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"flood"},"keywordTermURI":{"typeName":"keywordTermURI","multiple":false,"typeClass":"primitive","value":"http://vocabularies.unesco.org/thesaurus/concept10949"},"keywordVocabulary":{"typeName":"keywordVocabulary","multiple":false,"typeClass":"primitive","value":"Unesco"},"keywordVocabularyURI":{"typeName":"keywordVocabularyURI","multiple":false,"typeClass":"primitive","value":"https://vocabularies.unesco.org/unesco/"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"urban flooding"},"keywordTermURI":{"typeName":"keywordTermURI","multiple":false,"typeClass":"primitive","value":"http://purl.obolibrary.org/obo/ENVO_01000718"},"keywordVocabulary":{"typeName":"keywordVocabulary","multiple":false,"typeClass":"primitive","value":"ENVO"},"keywordVocabularyURI":{"typeName":"keywordVocabularyURI","multiple":false,"typeClass":"primitive","value":"https://www.ebi.ac.uk/ols4/ontologies/envo"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"Ho Chi Minh City"},"keywordTermURI":{"typeName":"keywordTermURI","multiple":false,"typeClass":"primitive","value":"https://thesaurus.ecoi.net/en/concepts/_5358a468.html"},"keywordVocabulary":{"typeName":"keywordVocabulary","multiple":false,"typeClass":"primitive","value":"iQvoc"},"keywordVocabularyURI":{"typeName":"keywordVocabularyURI","multiple":false,"typeClass":"primitive","value":"https://thesaurus.ecoi.net/"}}]},{"typeName":"topicClassification","multiple":true,"typeClass":"compound","value":[{"topicClassValue":{"typeName":"topicClassValue","multiple":false,"typeClass":"controlledVocabulary","value":"Urbanization and urban societies"},"topicClassVocab":{"typeName":"topicClassVocab","multiple":false,"typeClass":"primitive","value":"NumeriSud"},"topicClassVocabURI":{"typeName":"topicClassVocabURI","multiple":false,"typeClass":"primitive","value":"https://uri.ird.fr/so/kos/tnu/102"}}]},{"typeName":"publication","multiple":true,"typeClass":"compound","value":[{"publicationCitation":{"typeName":"publicationCitation","multiple":false,"typeClass":"primitive","value":"Radziute, G. (2026). Construction d’une base de données historiques sur les inondations à Hô Chi Minh-Ville, Vietnam [Mémoire de master 2 non publié]. Université Grenoble Alpes"}}]},{"typeName":"notesText","multiple":false,"typeClass":"primitive","value":"Main CRS: VN-2000 TM-3 105-45 (EPSG:9210)\n(some ancillary layers are in EPSG:4326, WGS84 — see table below)\n<br>\n<ul>\n<li>Geographic extent (bounding box, EPSG:9210):\n  <br>Xmin = 579876.06   Ymin = 1149942.63\n  <br>Xmax = 649903.88   Ymax = 1233962.63\n<li>The spatial and temporal coverage of the observations entirely depends on the availability and reliability of the sources (mainly Vietnamese newspapers); less widely reported events are likely under-represented.\n<li>Administrative references (districts, wards) sometimes follow the  boundaries in effect before the reform of 1 July 2025; the Current_admin_unit field allows correspondence with the current administrative division.\n<li>See the thesis for a full discussion of methodological limitations."},{"typeName":"language","multiple":true,"typeClass":"controlledVocabulary","value":["English"]},{"typeName":"productionDate","multiple":false,"typeClass":"primitive","value":"2026-09-10"},{"typeName":"productionPlace","multiple":true,"typeClass":"primitive","value":["Saint-Martin-d'Hères, France"]},{"typeName":"grantNumber","multiple":true,"typeClass":"compound","value":[{"grantNumberAgency":{"typeName":"grantNumberAgency","multiple":false,"typeClass":"primitive","value":"IRD-LMI CARE"}}]},{"typeName":"distributionDate","multiple":false,"typeClass":"primitive","value":"2026-09-10"},{"typeName":"depositor","multiple":false,"typeClass":"primitive","value":"HARDY, Sebastien"},{"typeName":"dateOfDeposit","multiple":false,"typeClass":"primitive","value":"2026-09-06"},{"typeName":"timePeriodCovered","multiple":true,"typeClass":"compound","value":[{"timePeriodCoveredStart":{"typeName":"timePeriodCoveredStart","multiple":false,"typeClass":"primitive","value":"2002-01-01"},"timePeriodCoveredEnd":{"typeName":"timePeriodCoveredEnd","multiple":false,"typeClass":"primitive","value":"2026-08-16"}}]},{"typeName":"dateOfCollection","multiple":true,"typeClass":"compound","value":[{"dateOfCollectionStart":{"typeName":"dateOfCollectionStart","multiple":false,"typeClass":"primitive","value":"2026-04-01"},"dateOfCollectionEnd":{"typeName":"dateOfCollectionEnd","multiple":false,"typeClass":"primitive","value":"2026-08-14"}}]},{"typeName":"kindOfData","multiple":true,"typeClass":"primitive","value":["Aggregate data","Analysis data","Process-produced data","Other data"]}]},"geospatial":{"displayName":"Geospatial Metadata","name":"geospatial","fields":[{"typeName":"geographicCoverage","multiple":true,"typeClass":"compound","value":[{"country":{"typeName":"country","multiple":false,"typeClass":"controlledVocabulary","value":"Viet Nam"},"state":{"typeName":"state","multiple":false,"typeClass":"primitive","value":"Ho Chi Minh City (HCMC)"},"city":{"typeName":"city","multiple":false,"typeClass":"primitive","value":"Ho Chi Minh City"}}]},{"typeName":"geographicBoundingBox","multiple":true,"typeClass":"compound","value":[{"westLongitude":{"typeName":"westLongitude","multiple":false,"typeClass":"primitive","value":"106.13429217070295"},"eastLongitude":{"typeName":"eastLongitude","multiple":false,"typeClass":"primitive","value":"107.12500782929705"},"northLatitude":{"typeName":"northLatitude","multiple":false,"typeClass":"primitive","value":"11.30876029996431"},"southLatitude":{"typeName":"southLatitude","multiple":false,"typeClass":"primitive","value":"10.337279700035689"}}]}]}},"files":[{"description":"Tabular version of the same data (425 rows, 22 attributes)","label":"Flood_event_locations.tab","restricted":false,"directoryLabel":"HCMC_floods","version":3,"datasetVersionId":28049,"categories":["Données"],"dataFile":{"id":50148,"persistentId":"","filename":"Flood_event_locations.tab","contentType":"text/tab-separated-values","friendlyType":"Tab-Delimited","filesize":96687,"description":"Tabular version of the same data (425 rows, 22 attributes)","categories":["Données"],"storageIdentifier":"file://1a07b97f711-680592a9d1d1","originalFileFormat":"text/tsv","originalFormatLabel":"Tab-Separated Values","originalFileSize":82200,"originalFileName":"Flood_event_locations.tab","UNF":"UNF:6:EhnzG/hpLSXWtp5Zkd4yZQ==","rootDataFileId":-1,"md5":"39de82a4ff2401e527a6dc5be13b25f0","checksum":{"type":"MD5","value":"39de82a4ff2401e527a6dc5be13b25f0"},"tabularData":true,"creationDate":"2026-09-07","publicationDate":"2026-09-09","fileAccessRequest":true}},{"description":"Layer \"Flood_event_locations\" — 425 points, EPSG:9210\n      Main layer: geolocated flood observations","label":"HCMC_Floods_BDD.gpkg","restricted":false,"directoryLabel":"HCMC_floods/Layer_files","version":4,"datasetVersionId":28049,"categories":["Données"],"dataFile":{"id":50143,"persistentId":"","filename":"HCMC_Floods_BDD.gpkg","contentType":"application/octet-stream","friendlyType":"Unknown","filesize":249856,"description":"Layer \"Flood_event_locations\" — 425 points, EPSG:9210\n      Main layer: geolocated flood observations","categories":["Données"],"storageIdentifier":"file:/